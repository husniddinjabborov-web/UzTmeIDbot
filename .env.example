# Nusxa oling: cp .env.example .env  — va o'z qiymatlaringizni kiriting.
# .env faylini HECH QACHON Git'ga qo'shmang.

# ── Majburiy ──────────────────────────────────────────────
BOT_TOKEN=

# ── Ixtiyoriy: limitlarni oshirish (kalitsiz ham ishlaydi) ───
GITHUB_TOKEN=            # github.com/settings/tokens — ruxsatlarsiz (public) token yetarli
GITLAB_TOKEN=            # gitlab.com → Preferences → Access tokens (read_api)
STACKEXCHANGE_KEY=       # stackapps.com orqali ilova ro'yxatdan o'tkazing

# ── Kalit bo'lsa kengayadigan funksiyalar ───────────────────
YOUTUBE_API_KEY=         # @handle/kanal ID uchun MAJBURIY; video/kanal ID'ni tasdiqlaydi
REDDIT_CLIENT_ID=        # reddit.com/prefs/apps ("script" yoki "web app")
REDDIT_CLIENT_SECRET=    # Reddit kalitsiz server IP'larini ko'pincha bloklaydi

# ── Majburiy kalit talab qiladigan adapterlar ───────────────
TWITCH_CLIENT_ID=        # dev.twitch.tv/console
TWITCH_CLIENT_SECRET=

# ── Qo'shimcha serverlar (vergul bilan, faqat host nomi) ────
MASTODON_HOSTS=          # masalan: social.example.org,mastodon.example.net
GITEA_HOSTS=             # masalan: git.example.org
